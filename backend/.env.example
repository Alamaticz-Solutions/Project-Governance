# Application
APP_NAME="ABC Health Project Governance Portal"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/governance_db
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/governance_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@abchealth.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@abchealth.com
EMAIL_FROM_NAME="ABC Governance Portal"

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Smartsheet
SMARTSHEET_ACCESS_TOKEN=your-smartsheet-token
SMARTSHEET_SHEET_ID=your-sheet-id

# OpenAI (GenAI)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
S3_BUCKET_NAME=governance-portal-docs
