# Application
APP_NAME="ABC Health Project Governance Portal"
APP_VERSION="2.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
SERVER_HOST=0.0.0.0
API_PORT=8000

# Database (same Postgres this app has always used)
DATABASE_URL=postgres://postgres:password@localhost:5432/governance_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — React dev server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (SMTP) — leave SMTP_USER blank to mock-send in dev
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@abchealth.com
EMAIL_FROM_NAME="ABC Governance Portal"

# OpenAI (intake document AI extraction + meeting transcript pipeline)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ── Teams meeting + VTT (Microsoft Graph route) ─────────────────────────────
# App-only (client-credentials) Graph integration. Leave GRAPH_* blank => "local
# stub" mode: meetings get a fake join link and you ingest the .vtt manually in
# Meeting Center. See docs/TEAMS_GRAPH_API_MIGRATION_PLAN.md and
# docs/TEAMS_GRAPH_ADMIN_RUNBOOK.md.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# App registration client secret — secret store only, never commit a real value.
GRAPH_CLIENT_SECRET=
# Entra object id (or UPN) of the mailbox that organizes every portal-scheduled
# meeting, plus that mailbox's email address (display-only on the record).
GRAPH_DEFAULT_ORGANIZER_ID=
GRAPH_DEFAULT_ORGANIZER_EMAIL=
# Public HTTPS base this backend is reachable at, for Graph change notifications.
# Deployed: https://pdsgovernance.onrender.com  ·  local dev: an ngrok https URL.
# Blank => transcript auto-ingest is disabled (scheduling still works).
GRAPH_NOTIFICATION_BASE_URL=
# Random 32+ char string echoed back in every notification; mismatches dropped.
GRAPH_NOTIFICATION_CLIENT_STATE=
# Requested subscription lifetime in minutes (getAllTranscripts allows <= ~4230).
GRAPH_SUBSCRIPTION_MINUTES=4230
