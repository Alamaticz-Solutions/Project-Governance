# Application
APP_NAME="ABC Health Project Governance Portal"
APP_VERSION="2.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
SERVER_HOST=0.0.0.0
API_PORT=8000

# Database (same Postgres this app has always used)
DATABASE_URL=postgres://postgres:password@localhost:5432/governance_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — React dev server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (SMTP) — leave SMTP_USER blank to mock-send in dev
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@abchealth.com
EMAIL_FROM_NAME="ABC Governance Portal"

# OpenAI (intake document AI extraction + meeting transcript extraction)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ── Microsoft Graph / Teams — Teams meeting + VTT POC ────────────────────────
# Leave all blank to run the POC in "local stub" mode: meetings get a fake
# join link and you ingest the .vtt manually (paste / upload) in the POC page.
# Fill these in to enable real Teams meeting scheduling + automatic transcript
# ingest via Graph change notifications.
#
# Setup (tenant admin, one time):
#   1. Entra app registration -> GRAPH_CLIENT_ID / GRAPH_TENANT_ID / GRAPH_CLIENT_SECRET
#   2. Application permissions (admin consent): OnlineMeetings.ReadWrite.All,
#      OnlineMeetingTranscript.Read.All
#   3. Teams PowerShell: New-CsApplicationAccessPolicy + Grant-CsApplicationAccessPolicy
#      binding GRAPH_CLIENT_ID to the organizer account(s)
#   4. Teams admin center -> Meeting policy -> "Transcript API access" = On
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# AAD object id (and email) of the account meetings are created as / transcripts read for
GRAPH_DEFAULT_ORGANIZER_ID=
GRAPH_DEFAULT_ORGANIZER_EMAIL=
# Random secret echoed in every change notification
GRAPH_WEBHOOK_CLIENT_STATE=poc-teams-vtt-secret
# Public HTTPS URL Graph will POST transcript notifications to
# e.g. https://<ngrok-id>.ngrok.app/api/v1/teams-poc/webhooks/graph/transcripts
GRAPH_NOTIFICATION_URL=
