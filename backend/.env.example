# Application
APP_NAME="ABC Health Project Governance Portal"
APP_VERSION="2.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
SERVER_HOST=0.0.0.0
API_PORT=8000

# Database (same Postgres this app has always used)
DATABASE_URL=postgres://postgres:password@localhost:5432/governance_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — React dev server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (SMTP) — leave SMTP_USER blank to mock-send in dev
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@abchealth.com
EMAIL_FROM_NAME="ABC Governance Portal"

# OpenAI (intake document AI extraction + meeting transcript pipeline)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ── Teams meeting + VTT (Power Automate route) ──────────────────────────────
# No Microsoft Graph / app registration. Blank => "local stub" mode: meetings
# get a fake join link and you ingest the .vtt manually in Meeting Center.
# See docs/TEAMS_POWER_AUTOMATE_SETUP.md.
#
# Power Automate flow "When a HTTP request is received" trigger URL. Portal
# POSTs {subject,start_time,end_time,organizer_email}; the flow creates the
# Teams meeting and returns {join_url, meeting_ref}.
POWER_AUTOMATE_SCHEDULE_URL=
# Shared secret for POST /api/v1/teams-poc/ingest (the endpoint a Power
# Automate transcript flow calls). Sent as the x-api-key header. Blank => open.
INGEST_API_KEY=
# true => /teams-poc/ingest only accepts transcripts whose meeting_ref matches
# a meeting scheduled through the portal.
INGEST_REJECT_UNKNOWN=false
