{
  "name": "governance-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "appfw:check": "node scripts/check-scaffold.mjs",
    "phi:check": "node scripts/check-phi-lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "npm run appfw:check && npm run phi:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.11.0",
    "@xyflow/react": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
