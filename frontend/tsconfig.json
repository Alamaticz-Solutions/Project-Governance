{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@appfw/pds-health-components": ["../../app-framework/appfw_ui/pds_health/components/src/index.ts"],
      "@appfw/pds-health-components/styles.css": ["../../app-framework/appfw_ui/pds_health/components/src/styles.css"],
      "react-dom": ["node_modules/@types/react-dom/index.d.ts"]
    }
  },
  "include": ["src"]
}
