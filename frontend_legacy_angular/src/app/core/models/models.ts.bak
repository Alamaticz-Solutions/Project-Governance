/* Application models / interfaces */

export type UserRole =
  | 'admin' | 'project_manager' | 'bta' | 'epmo'
  | 'finance' | 'vendor_screening' | 'analysis_team'
  | 'eac' | 'cab' | 'security' | 'taf' | 'trc' | 'pic' | 'viewer';

export type ProjectStatus = 'draft' | 'active' | 'on_hold' | 'completed' | 'cancelled' | 'archived';
export type ProjectPriority = 'critical' | 'high' | 'medium' | 'low';
export type ProjectRisk = 'very_high' | 'high' | 'medium' | 'low';
export type GateStatus = 'pending' | 'in_review' | 'approved' | 'rejected' | 'needs_info';
export type ApprovalDecision = 'approved' | 'rejected' | 'needs_info' | 'deferred';

export interface User {
  id: string;
  email: string;
  username: string;
  full_name: string;
  role: UserRole;
  department?: string;
  job_title?: string;
  phone?: string;
  avatar_url?: string;
  is_active: boolean;
  is_verified: boolean;
  last_login?: string;
  created_at: string;
}

export interface AuthTokens {
  access_token: string;
  refresh_token: string;
  token_type: string;
  user: User;
}

export interface Project {
  id: string;
  project_number: string;
  project_name: string;
  business_unit: string;
  department?: string;
  sponsor_name?: string;
  sponsor_email?: string;
  description?: string;
  problem_statement?: string;
  business_value?: string;
  budget_estimated?: number;
  budget_approved?: number;
  budget_type?: string;
  priority: ProjectPriority;
  risk_level?: ProjectRisk;
  status: ProjectStatus;
  it_involvement: boolean;
  vendor_required: boolean;
  has_phi_data: boolean;
  is_clinical: boolean;
  is_hipaa_applicable: boolean;
  smartsheet_row_id?: string;
  requested_start_date?: string;
  requested_end_date?: string;
  actual_start_date?: string;
  submitted_at?: string;
  created_at: string;
  updated_at?: string;
  project_manager?: {
    id: string;
    full_name: string;
    email: string;
    role: string;
  };
}

export interface ProjectListResponse {
  items: Project[];
  total: number;
  page: number;
  page_size: number;
  total_pages: number;
}

export interface GateReview {
  id: string;
  project_id: string;
  gate_code: string;
  gate_name: string;
  committee?: string;
  status: GateStatus;
  priority?: ProjectPriority;
  decision?: ApprovalDecision;
  decision_notes?: string;
  submitted_at?: string;
  due_date?: string;
}

export interface DashboardKPI {
  active_projects: number;
  pending_approvals: number;
  completed_this_month: number;
  risk_items: number;
  my_pending_tasks: number;
  overdue_tasks: number;
}

export interface Notification {
  id: string;
  notification_type: string;
  title: string;
  message: string;
  action_url?: string;
  is_read: boolean;
  created_at: string;
}

export interface ApiResponse<T> {
  data: T;
  message?: string;
  success: boolean;
}

export interface PagedResponse<T> {
  items: T[];
  total: number;
  page: number;
  page_size: number;
  total_pages: number;
}
